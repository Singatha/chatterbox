# Copy to .env before running Docker Compose.
POSTGRES_DB=chat
POSTGRES_USER=chat
POSTGRES_PASSWORD=chat_dev_password
DATABASE_URL=postgresql+asyncpg://chat:chat_dev_password@postgres:5432/chat
JWT_SECRET=replace-with-at-least-32-random-characters
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
REDIS_URL=redis://redis:6379/0
REDIS_REQUIRED=true
REDIS_KEY_PREFIX=chatterbox
PRESENCE_TTL_SECONDS=30
PRESENCE_HEARTBEAT_SECONDS=10
TYPING_TTL_SECONDS=5
REALTIME_RATE_LIMIT_WINDOW_SECONDS=60
MESSAGE_SEND_RATE_LIMIT=30
TYPING_RATE_LIMIT=120
RECEIPT_RATE_LIMIT=120
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=replace-with-a-secure-minio-password

